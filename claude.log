      41 +class CachingTransport(Transport):                             
      42 +    """                                                        
      43 +    Wraps another transport, caching reads per user and invalid
         +ating on writes.                                               
      44 +                                                               
      45 +    Reads are the methods marked with @cached; every other call
         + is a write,                                                   
      46 +    which invalidates the cached entries (of all users) that re
         +ad the written                                                 
      47 +    service. Mesh calls made while computing a read are recorde
         +d as                                                           
      48 +    dependencies of that read.                                 
      49 +    """                                                        
      50 +                                                               
      51 +    def __init__(                                              
      52 +        self,                                                  
      53 +        inner: Transport,                                      
      54 +        cache: CacheBackend,                                   
      55 +        user_id: Optional[int],                                
      56 +        policy: Dict[Tuple[str, str], FrozenSet[str]],         
      57 +    ):                                                         
      58 +        self._inner = inner                                    
      59 +        self._cache = cache                                    
      60 +        self._user_id = user_id                                
      61 +        self._policy = policy                                  
